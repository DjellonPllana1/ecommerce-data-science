# Copy to .env and replace the development-only placeholders.
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg2://ecommerce_user:replace_with_a_url_encoded_password@localhost:5434/ecommerce_db
